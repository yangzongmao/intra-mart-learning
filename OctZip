		List<String> dataInfoList = new ArrayList<String>();
		if (dataInfoSize > 1) {
			String dataInfoStr = octalString.substring(12, dataInfoSize * 12);
			for (int i = 0; i < dataInfoStr.length(); i += 12) {
				dataInfoList.add(dataInfoStr.substring(i, i + 12));
			}
		}

		String compressedOctStr = octalString.substring(dataInfoSize * 12);
		List<String> compressedOct = new ArrayList<String>();
		for (int i = 0; i < compressedOctStr.length(); i += 12) {
			compressedOct.add(compressedOctStr.substring(i, i + 12));
		}
		int startIndex = 0;
		int endIndex = 0;
		String insertStr = "";
		for (String dataInfo : dataInfoList) {
			startIndex = Integer.parseInt(dataInfo.substring(1, 6), 8);
			endIndex = Integer.parseInt(dataInfo.substring(6), 8);
			if (dataInfo.startsWith("0")) {
				insertStr = "000000000000";
			} else if (dataInfo.startsWith("4")) {
				insertStr = "040040040040";
			}
			for (int i = startIndex; i <= endIndex; i++) {
				compressedOct.add(i, insertStr);
			}
		}
		CompressResult compressResult = new CompressResult();
		compressResult.setCompressedOct(StringUtils.join(compressedOct, ""));
		return compressResult;
	}

