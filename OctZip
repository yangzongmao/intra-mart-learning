	private static List<IntervalDto> findIntervals(List<Integer> numbers, String octData) {
		List<IntervalDto> intervals = new ArrayList<IntervalDto>();
		if (numbers.isEmpty())
			return intervals;

		int start = numbers.get(0);
		int end = start;

		for (int i = 1; i < numbers.size(); i++) {
			if (numbers.get(i) == end + 1) {
				end = numbers.get(i);
			} else {
				intervals.add(new IntervalDto(octData, start, end));
				start = numbers.get(i);
				end = start;
			}
		}
		intervals.add(new IntervalDto(octData, start, end));
		return intervals;
	}

	public static String octalToBinary(String octalString) {
		StringBuilder binaryString = new StringBuilder();
		for (char c : octalString.toCharArray()) {
			int decimal = Character.getNumericValue(c); // 将字符转换为数值
			String binary = String.format("%3s", Integer.toBinaryString(decimal)).replace(' ', '0'); // 转换为3位二进制
			binaryString.append(binary);
		}
		return binaryString.toString();
	}

	/**
	 * 将 byte[] 转换为 8 进制字符串，每个 byte 用 3 位 8 进制表示
	 * @param bytes 输入的 byte 数组
	 * @return 8 进制字符串
	 */
	private static String byteArrayToOctalString(byte[] bytes) {
		StringBuilder octalString = new StringBuilder();

		for (byte b : bytes) {
			int unsignedByte = b & 0xFF; // 转换为无符号整数 (0 ~ 255)
			octalString.append(String.format("%03o", unsignedByte)); // 转换为 3 位 8 进制
		}

		return octalString.toString();
	}

	private String convert1(String binary) {
		long value = Long.parseUnsignedLong(binary, 2);
		String octal = Long.toOctalString(value);

		char[] paddedOctal = new char[12];
		int paddingLength = 12 - octal.length();
		for (int i = 0; i < paddingLength; i++) {
			paddedOctal[i] = '0';
		}
		octal.getChars(0, octal.length(), paddedOctal, paddingLength);
		return new String(paddedOctal);
	}

	private String generate() {
		StringBuilder sb = new StringBuilder(36);
		Random random = new Random();
		for (int i = 0; i < 36; i++) {
			sb.append(random.nextInt(2)); // 生成 0 或 1
		}
		return sb.toString();
	}

	private static String generateOctalString(int length) {
		StringBuilder sb = new StringBuilder(length);
		ThreadLocalRandom random = ThreadLocalRandom.current();
		for (int i = 0; i < length; i++) {
			sb.append(random.nextInt(8)); // 生成 0-7 的随机数
		}
		return sb.toString();
	}
